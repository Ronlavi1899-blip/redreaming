# שמות בלבד. אין להכניס ערכים אמיתיים לקובץ הזה ואין לעשות לו commit עם ערכים.
# הערכים עצמם נכנסים ב-Netlify: Site configuration → Environment variables.

# ── PayPlus ──
# ה-secret key מהחשבון. משמש לאימות חתימת ה-HMAC על ה-callback.
# PayPlus → הגדרות → מפתחות API
PAYPLUS_SECRET_KEY=

# ── Meta ──
# מזהה ה-Pixel/Dataset. אותו מזהה שמופיע ב-HTML.
META_PIXEL_ID=

# טוקן גישה ל-Conversions API.
# Events Manager → בחירת ה-Dataset → Settings → Conversions API → Generate access token
META_ACCESS_TOKEN=

# אופציונלי, לבדיקות בלבד. Events Manager → Test events.
# חובה להסיר בפרודקשן, אחרת האירועים לא נספרים כהמרות אמיתיות.
META_TEST_EVENT_CODE=

# ── כללי ──
# כתובת הבסיס של האתר, לשדה event_source_url.
SITE_URL=https://redreaming.netlify.app
